# =========================================
# SECRETS & CREDENTIALS (CRITICAL)
# =========================================
# Ignore all environment variable files anywhere in the project
.env
*.env
**/.env
.env.local
.env.*

# Ignore AWS credential backups and keys
*.pem
*.key

# =========================================
# PYTHON CACHE & ARTIFACTS
# =========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# =========================================
# VIRTUAL ENVIRONMENTS
# =========================================
.venv/
venv/
env/
ENV/
.Python

# =========================================
# IDE & OS ARTIFACTS
# =========================================
# VS Code
.vscode/
*.code-workspace

# Mac/Windows OS files
.DS_Store
Thumbs.db

# =========================================
# LOG FILES
# =========================================
*.log
pip-log.txt
pip-delete-this-directory.txt